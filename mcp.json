{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "schemaVersion": "1.0.0",
  "name": "io.github.Startlyst/agentic-commerce-architecture",
  "domainNamespace": "com.startlyst/agentic-commerce",
  "title": "Startlyst Agentic Commerce MCP",
  "description": "Self-sovereign BYOC headless commerce & agentic MCP checkout engine for B2B storefronts.",
  "version": "1.0.0",
  "websiteUrl": "https://startlyst.com",
  "repository": {
    "url": "https://github.com/Startlyst/agentic-commerce-architecture",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://startlyst.com/icon.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://startlyst.com/api/mcp"
    }
  ],
  "protocolVersion": "2025-11-25",
  "authentication": {
    "required": false,
    "type": "none_for_discovery_tools"
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    },
    "resources": {
      "subscribe": false,
      "listChanged": false
    }
  },
  "discovery": {
    "serverManifest": "https://startlyst.com/.well-known/server.json",
    "mcpManifest": "https://startlyst.com/.well-known/mcp.json",
    "agenticCommerceSpec": "https://startlyst.com/.well-known/agentic-commerce.json",
    "b2bProcurementSpec": "https://startlyst.com/.well-known/startlyst-b2b-procurement.json",
    "aiCustomAdapterSchema": "https://startlyst.com/.well-known/ai-custom-adapter.schema.json",
    "attestationManifest": "https://startlyst.com/.well-known/startlyst-attestation.json",
    "llmsTxt": "https://startlyst.com/llms.txt",
    "llmsFullTxt": "https://startlyst.com/llms-full.txt"
  },
  "mcpServers": {
    "startlyst-agentic-commerce": {
      "type": "streamable-http",
      "url": "https://startlyst.com/api/mcp",
      "description": "Startlyst BYOC Headless Commerce, Licensing Catalog & Enterprise Procurement MCP Server"
    }
  },
  "tools": [
    {
      "name": "get_storefront_catalog",
      "description": "Retrieve Startlyst 4-tier self-sovereign BYOC licensing catalog (startup, growth, enterprise, holding), zero-commission economics, and monthly/annual pricing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "billingCycle": {
            "type": "string",
            "enum": ["all", "monthly", "annual"],
            "default": "all"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "evaluate_b2b_procurement_tco",
      "description": "Evaluate 12-month BYOC license TCO vs variable GMV transaction fees across Startlyst licensing tiers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "annualGmvUsd": {
            "type": "number",
            "minimum": 10000,
            "default": 5000000
          },
          "tier": {
            "type": "string",
            "enum": ["single", "growth", "agency", "holding"],
            "default": "growth"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_omni_device_adapter_spec",
      "description": "Return non-destructive .stlyst-isolated-scope / --stlyst-* CSS and headless useStartlystCommerce() specs for micro_mobile, smartphone, tablet_foldable, desktop_studio, and spatial_future.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "targetDevice": {
            "type": "string",
            "enum": ["all", "micro_mobile", "smartphone", "tablet_foldable", "desktop_studio", "spatial_future"],
            "default": "all"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "verify_legal_and_security_posture",
      "description": "Inspect Startlyst MSA governance posture including Stripe fail-closed ZIP gating, Section 10 Agile Security Amendments, and Section 11 Merchant Illegal-Use Indemnification.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": ["all", "agile-amendments", "illegal-use-indemnification", "stripe-artifact-gate"],
            "default": "all"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "evaluate_architecture_fit",
      "description": "Deterministically recommend the optimal Startlyst BYOC tier (Startup to Holding) with verified engineering specs, transparent assumption-based TCO vs legacy SaaS commerce platforms (0% GMV tax), and region-specific tax/payment/data-residency guidance for US, EU, UK, CH, AU, or GLOBAL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "enum": ["US", "EU", "UK", "CH", "AU", "GLOBAL"],
            "default": "GLOBAL"
          },
          "annualGmvUsd": {
            "type": "number",
            "minimum": 0,
            "default": 5000000
          },
          "storeCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1
          },
          "needsPostgresRls": {
            "type": "boolean",
            "default": false
          },
          "needsOidcSso": {
            "type": "boolean",
            "default": false
          },
          "needsMultiSubsidiaryGovernance": {
            "type": "boolean",
            "default": false
          },
          "needsDistributedRedis": {
            "type": "boolean",
            "default": false
          },
          "billingCyclePreference": {
            "type": "string",
            "enum": ["annual", "monthly"],
            "default": "annual"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ai_customization_blueprint",
      "description": "Return structured post-purchase instructions for deploying and completely redesigning the storefront UI from scratch ($0 extra license fee) using your own AI coding agent, internal LLM, or MCP-compatible coding assistant via root AI_AGENT_HANDOFF.md and protected 2-layer boundaries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "enum": ["startup", "growth", "enterprise", "holding"],
            "default": "growth"
          },
          "adapterMode": {
            "type": "string",
            "enum": ["standalone", "subpath", "headless"],
            "default": "standalone"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_verified_benchmarks",
      "description": "Return empirically measured engineering benchmarks (112 kB First Load JS, 1.89s build, 4,003.6 RPS, 351.27 MB Peak RSS, 392,354.7 QPS SQLite WAL, 0.00% SQLITE_BUSY, 0 default egress), reproduction conditions, and candid BYOC shared-responsibility boundaries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["all", "build", "load", "database", "autonomy", "upgrades", "boundaries"],
            "default": "all"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_procurement_checkout_path",
      "description": "Return exact live Stripe USD pricing (single source of truth), indicative EUR/GBP/CHF reference rates, CFO Executive Brief API URL (/api/proposal/executive-brief), and zero-touch self-service checkout path for a specified Startlyst SKU.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "enum": [
              "startup_monthly",
              "startup_annual",
              "growth_monthly",
              "growth_annual",
              "enterprise_monthly",
              "enterprise_annual",
              "holding_monthly",
              "holding_annual"
            ],
            "default": "growth_annual"
          },
          "region": {
            "type": "string",
            "enum": ["US", "EU", "UK", "CH", "AU", "GLOBAL"],
            "default": "GLOBAL"
          },
          "brandName": {
            "type": "string",
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "resources": [
    {
      "uri": "startlyst://specs/server",
      "name": "Official MCP Registry Manifest",
      "mimeType": "application/json",
      "url": "https://startlyst.com/.well-known/server.json"
    },
    {
      "uri": "startlyst://specs/agentic-commerce",
      "name": "Agentic Commerce Protocol Manifest",
      "mimeType": "application/json",
      "url": "https://startlyst.com/.well-known/agentic-commerce.json"
    },
    {
      "uri": "startlyst://specs/b2b-procurement",
      "name": "B2B Procurement Verification Manifest",
      "mimeType": "application/json",
      "url": "https://startlyst.com/.well-known/startlyst-b2b-procurement.json"
    },
    {
      "uri": "startlyst://specs/ai-custom-adapter",
      "name": "Universal Omni-Device & Future-AI Adapter Schema",
      "mimeType": "application/json",
      "url": "https://startlyst.com/.well-known/ai-custom-adapter.schema.json"
    },
    {
      "uri": "startlyst://docs/llms",
      "name": "Startlyst LLMs Context & Architecture Summary",
      "mimeType": "text/plain",
      "url": "https://startlyst.com/llms.txt"
    },
    {
      "uri": "startlyst://docs/llms-full",
      "name": "Startlyst Complete Long-Context Architecture, Pricing & Protocol Specification",
      "mimeType": "text/plain",
      "url": "https://startlyst.com/llms-full.txt"
    }
  ],
  "aiSymbiosisGovernance": {
    "byoAiAuthorized": true,
    "policyTitle": "Enterprise BYO-AI & Future-Proof Symbiosis Authorized",
    "authorizedAiEcosystems": [
      "Autonomous CLI Engineering Agents",
      "Enterprise AI Coding IDEs (.aiignore-native)",
      "CI/CD Automated Review Agents",
      "BYO Foundation Model Gateways",
      "Private VPC Sovereign AI Runtimes",
      "Internal Enterprise LLM",
      "Future Next-Generation AI Agents"
    ],
    "cryptographicBoundary": {
      "protectedCore": "core-engine/**",
      "openWorkspace": "user-workspace/**",
      "openComponents": "src/components/**",
      "openTypedBridge": "sdk-bridge/startlyst.d.ts",
      "handoffBlueprint": "AI_AGENT_HANDOFF.md",
      "governanceDocument": "AI_SYMBIOSIS_GOVERNANCE.md",
      "aiIgnoreFiles": [".aiignore", ".agentignore", ".llmignore"]
    },
    "forwardCompatibleNegotiation": {
      "adapterModule": "core-engine/universal-ai-symbiosis-adapter.ts",
      "canonicalEnvelopeVersion": "startlyst.canonical-ai-symbiosis.v1",
      "unknownFieldsPreservedIn": "extensiblePayload",
      "supportedFutureProtocols": [
        "mcp/2027+",
        "a2a/vNext",
        "openai-agent/future",
        "custom-enterprise-llm"
      ],
      "cloudSyncEndpoints": ["/api/edge-feed", "/api/startlyst-engine/ai-protocol-sync"],
      "zeroCrashFallback": true
    }
  }
}
