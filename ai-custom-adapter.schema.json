{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaId": "https://startlyst.com/.well-known/ai-custom-adapter.schema.json",
  "protocol": "startlyst.universal-omni-device-ai-adapter.v1",
  "canonicalOrigin": "https://startlyst.com",
  "nonDestructiveHostGuarantee": {
    "cssIsolationScope": ".stlyst-isolated-scope",
    "cssCustomPropertyNamespace": "--stlyst-*",
    "zeroGlobalCssReset": true,
    "zeroRootRouteTakeoverInSubpathOrHeadless": true,
    "supportedMountModes": [
      "standalone",
      "subpath",
      "headless"
    ],
    "headlessHookEntrypoint": "useStartlystCommerce()"
  },
  "omniDeviceViewportMatrix": {
    "smartphone": {
      "minWidthPx": 320,
      "maxWidthPx": 767,
      "minTouchTargetPx": 44,
      "inputFontFloorPx": 16
    },
    "tablet": {
      "minWidthPx": 768,
      "maxWidthPx": 1023,
      "minTouchTargetPx": 44,
      "adaptiveGrid": true
    },
    "desktop": {
      "minWidthPx": 1024,
      "ultraWideReady": true
    },
    "futureSpatialAndFoldable": {
      "dynamicViewportUnits": "dvh/svh",
      "containerQueriesReady": true
    }
  },
  "twoLayerIpBoundary": {
    "zeroRuntimeLockIn": true,
    "openCustomizationZone": [
      "user-workspace/**",
      "user-workspace/extensions/**",
      "src/lib/security-utils.ts",
      "src/components/**",
      "src/app/globals.css",
      "ai-custom-adapter.schema.json"
    ],
    "sealedProprietaryZone": [
      "core-engine/sealed-core.cjs",
      "core-engine/subscription-attestation-guard.ts",
      ".startlyst/core-manifest.json"
    ],
    "policy": "Licensed enterprises and their AI agents have 100% freedom to customize UI, responsive layouts, 7 extension hooks, security utilities, and checkout flows in user-workspace/** under Zero Runtime Lock-in (0 production phone-home calls), while core-engine/** remains read-only and SHA-256 integrity-verified for conflict-free updates."
  }
}
