    "aiCustomAdapterManifest": "https://startlyst.com/.well-known/ai-custom-adapter.schema.json",
    "attestationManifest": "https://startlyst.com/.well-known/startlyst-attestation.json",
    "subscriptionPreferencesEndpoint": "https://startlyst.com/api/subscription/preferences",
    "renewalNoticeEndpoint": "https://startlyst.com/api/subscription/renewal-notice",
